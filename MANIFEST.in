# Include important documentation and metadata files
include README.md
include LICENSE
include requirements.txt
include pyproject.toml

# Include example files and test data
include test_*.txt
include test_*.fasta
include *.md

# Include Jupyter notebooks for scientific validation
include *.ipynb
recursive-include genome_data *.fa *.fasta

# Include all Python source files
recursive-include dna_codec_advanced *.py

# Exclude development and temporary files
global-exclude __pycache__
global-exclude *.py[co]
global-exclude *.so
global-exclude .DS_Store
global-exclude *.backup
global-exclude fix_*.py
global-exclude improve_*.py

# Exclude Git and IDE files
prune .git
prune .idea
prune .vscode